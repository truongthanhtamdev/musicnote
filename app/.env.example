# Long random secret used to sign session cookies. Generate with e.g.
# `openssl rand -base64 48`. Keep it secret; changing it invalidates all
# existing logged-in sessions.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: where the SQLite database file is stored. Defaults to ./data
# relative to the project root.
# DATA_DIR=/var/lib/musicnote/data

# Mã đo Google Analytics 4. Mã của trung tâm đã để sẵn trong mã nguồn
# (src/lib/analytics.ts) nên BÌNH THƯỜNG KHÔNG CẦN KHAI GÌ Ở ĐÂY.
# Chỉ khai khi muốn trỏ sang property khác, hoặc khai rỗng để tắt hẳn.
# Đây là biến NEXT_PUBLIC_ nên phải build lại mới có tác dụng.
# `next dev` không bao giờ gửi dữ liệu, dù có khai hay không.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Token bot Telegram, lấy từ @BotFather trên Telegram (/newbot). Có token thì
# app tự bật bot nhắc lịch; bỏ trống thì toàn bộ phần Telegram tắt hẳn.
# Chỉ được chạy MỘT tiến trình app với token này.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gửi email cho khách (xác nhận đăng ký, lịch học thử, link Google Meet, nhắc
# trước giờ học). Dùng Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng"
# tại https://myaccount.google.com/apppasswords — dán 16 ký tự đó vào SMTP_PASS.
# Để trống thì web không gửi mail, mọi thứ khác vẫn chạy bình thường.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=pianoguitardemhat@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM="Piano Guitar Đệm Hát <pianoguitardemhat@gmail.com>"
